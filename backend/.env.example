# Copy to backend/.env and adjust. All values have safe development defaults in
# code, so this file is only required if you want to override them.

# --- Application ---
APP_NAME=FastAPI Vue Starter
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated list of origins allowed by CORS.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database ---
# The async (asyncpg) and Alembic (psycopg2) URLs are derived from these values.
# Under Docker Compose, POSTGRES_SERVER is overridden to the "db" service.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Optional: set DATABASE_URL to override the derived URL entirely (e.g. on a PaaS).
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/backend_db

# --- Cache / broker (optional) ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# CHANGE THIS in any non-local environment (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# --- Email (optional) ---
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
